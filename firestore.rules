rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate non-empty string
    function isNonEmptyString(str, maxLen) {
      return str is string && str.size() > 0 && str.size() <= maxLen;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /classes/{classId} {
      allow read, write: if true;
    }

    match /student_details/{detailId} {
      allow read, write: if true;
    }

    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    match /quiz_results/{resultId} {
      allow read, write: if true;
    }

    match /teacher_comments/{commentId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /school_info/{infoId} {
      allow read, write: if true;
    }

    match /question_bank/{itemId} {
      allow read, write: if true;
    }

    match /parent_alerts/{alertId} {
      allow read, write: if true;
    }

    // Default allow for school app collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
