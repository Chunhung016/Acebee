{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/acebeemath/:match*",
      "destination": "/acebeemath/:match*"
    },
    {
      "source": "/plant-growth-lab",
      "destination": "/plant-growth-lab/index.html"
    },
    {
      "source": "/plant-growth-lab/:match*",
      "destination": "/plant-growth-lab/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
